<Window x:Class="PolirubroWPF.Ventas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Listado de Ventas"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Listado de Ventas"
                   FontSize="22"
                   FontWeight="Bold"/>

        <DataGrid x:Name="dgVentas"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  FontSize="14">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="80"/>

                <DataGridTextColumn Header="Fecha"
                                    Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}"
                                    Width="140"/>

                <DataGridTextColumn Header="Cliente"
                                    Binding="{Binding ClienteMostrar}"
                                    Width="*"/>

                <DataGridTextColumn Header="Total"
                                    Binding="{Binding TotalMostrar}"
                                    Width="150"/>

                <DataGridTemplateColumn Header="Ver" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Width="35"
                                    Height="35"
                                    FontSize="16"
                                    Background="#E0E0E0"
                                    BorderBrush="Transparent"
                                    Click="BtnVer_Click"
                                    CommandParameter="{Binding Id}">
                                👁
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="btnCerrar"
                    Content="Cerrar"
                    Width="100"
                    Height="35"
                    Click="btnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>