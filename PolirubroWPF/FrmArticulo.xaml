<Window x:Class="PolirubroWPF.FrmArticulo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo Artículo"
        Height="540"
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Código" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="txtCodigoProducto" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Text="Nombre" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="txtNombre" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Text="Descripción" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="txtDescripcion" Grid.Row="2" Grid.Column="1" Height="100" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

        <TextBlock Text="Precio" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="txtPrecio" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Text="Costo" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="txtCosto" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Text="Stock" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="txtStock" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Text="Stock mínimo" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="txtStockMinimo" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Text="Categoría" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="cmbCategoria" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button x:Name="btnGuardar" Content="Guardar" Width="100" Height="35" Margin="0,0,10,0" Click="btnGuardar_Click"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Width="100" Height="35" Click="btnCancelar_Click"/>
        </StackPanel>
    </Grid>
</Window>