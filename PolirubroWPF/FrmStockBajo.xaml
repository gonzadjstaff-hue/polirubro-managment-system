<Window x:Class="PolirubroWPF.FrmStockBajo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Productos con stock bajo"
        Height="500"
        Width="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Productos con stock bajo"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <DataGrid x:Name="dgStockBajo"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Margin="0,0,0,20"
                  FontSize="14">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Código"
                                    Binding="{Binding CodigoProducto}"
                                    Width="120"/>

                <DataGridTextColumn Header="Nombre"
                                    Binding="{Binding Nombre}"
                                    Width="*"/>

                <DataGridTextColumn Header="Categoría"
                                    Binding="{Binding Categoria.Nombre}"
                                    Width="160"/>

                <DataGridTextColumn Header="Stock actual"
                                    Binding="{Binding Stock}"
                                    Width="120"/>

                <DataGridTextColumn Header="Stock mínimo"
                                    Binding="{Binding StockMinimo}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Exportar a Excel"
                    Width="160"
                    Height="40"
                    FontSize="15"
                    FontWeight="Bold"
                    Background="#4CAF50"
                    Foreground="White"
                    Margin="0,0,10,0"
                    Click="BtnExportar_Click"/>

            <Button Content="Cerrar"
                    Width="120"
                    Height="40"
                    FontSize="15"
                    FontWeight="Bold"
                    Background="#757575"
                    Foreground="White"
                    Click="BtnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>