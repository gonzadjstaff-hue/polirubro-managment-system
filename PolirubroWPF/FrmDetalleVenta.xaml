<Window x:Class="PolirubroWPF.FrmDetalleVenta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalle de Venta"
        Height="550"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Venta #" FontWeight="Bold" FontSize="16"/>
            <TextBlock x:Name="txtIdVenta" Margin="10,0"/>
            <TextBlock Text="Fecha:" Margin="30,0,0,0" FontWeight="Bold"/>
            <TextBlock x:Name="txtFecha" Margin="10,0"/>
        </StackPanel>

        <DataGrid x:Name="dgDetalle"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Código"
                                    Binding="{Binding Articulo.CodigoProducto}"
                                    Width="120"/>

                <DataGridTextColumn Header="Producto"
                                    Binding="{Binding Articulo.Nombre}"
                                    Width="*"/>

                <DataGridTextColumn Header="Cantidad"
                                    Binding="{Binding Cantidad}"
                                    Width="120"/>

                <DataGridTextColumn Header="Precio"
                                    Binding="{Binding PrecioUnitario}"
                                    Width="120"/>

                <DataGridTextColumn Header="Subtotal"
                                    Binding="{Binding Subtotal}"
                                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <TextBlock Text="Total:"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,10,0"/>

            <TextBlock x:Name="txtTotal"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,20,0"/>

            <Button Content="Cerrar"
                    Width="100"
                    Height="35"
                    Click="BtnCerrar_Click"/>

        </StackPanel>

    </Grid>

</Window>