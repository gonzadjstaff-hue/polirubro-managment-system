<Window x:Class="PolirubroWPF.FrmVenta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nueva Venta"
        Height="650"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Fecha" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpFecha" Grid.Row="0" Grid.Column="1" SelectedDateFormat="Short"/>

                <CheckBox x:Name="chkConsumidorFinal"
                          Content="Consumidor Final"
                          Grid.Row="0"
                          Grid.Column="3"
                          VerticalAlignment="Center"
                          Checked="chkConsumidorFinal_Checked"
                          Unchecked="chkConsumidorFinal_Checked"/>

                <TextBlock Text="Nombre Cliente" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBox x:Name="txtNombreCliente" Grid.Row="2" Grid.Column="1" Margin="0,0,15,0"/>

                <TextBlock Text="Documento" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txtDocumentoCliente" Grid.Row="2" Grid.Column="3"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2"
                   Text="Carga de Artículos"
                   FontSize="18"
                   FontWeight="Bold"/>

        <Border Grid.Row="4" BorderBrush="LightGray" BorderThickness="1" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Código" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCodigoArticulo"
                         Grid.Column="1"
                         Margin="0,0,10,0"
                         KeyDown="txtCodigoArticulo_KeyDown"/>

                <TextBlock Grid.Column="2" Text="Nombre" VerticalAlignment="Center"/>
                <TextBox x:Name="txtNombreArticulo"
                         Grid.Column="3"
                         Margin="0,0,10,0"
                         KeyDown="txtNombreArticulo_KeyDown"/>

                <TextBlock Grid.Column="4" Text="Cant." VerticalAlignment="Center"/>
                <TextBox x:Name="txtCantidadAgregar"
                         Grid.Column="5"
                         Margin="0,0,10,0"
                         VerticalContentAlignment="Center"
                         KeyDown="txtCantidadAgregar_KeyDown"/>

                <Button x:Name="btnAgregarArticulo"
                        Grid.Column="6"
                        Content="Agregar"
                        Width="100"
                        Height="32"
                        Click="btnAgregarArticulo_Click"/>
            </Grid>
        </Border>

        <TextBlock Grid.Row="6"
                   Text="Detalle de la Venta"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"
                   VerticalAlignment="Top"/>

        <DataGrid x:Name="dgDetalleVenta"
                  Grid.Row="6"
                  Margin="0,35,0,0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Articulo.CodigoProducto}" Width="120"/>
                <DataGridTextColumn Header="Artículo" Binding="{Binding Articulo.Nombre}" Width="*"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="100"/>
                <DataGridTextColumn Header="Precio Unitario" Binding="{Binding PrecioUnitario, StringFormat=N2}" Width="150"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N2}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button x:Name="btnQuitarArticulo"
                        Content="Quitar Artículo"
                        Width="140"
                        Height="35"
                        Click="btnQuitarArticulo_Click"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <TextBlock Text="Total:"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>

                <TextBlock x:Name="txtTotal"
                           Text="$ 0,00"
                           Width="140"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,20,0"/>

                <Button x:Name="btnCancelar"
                        Content="Cancelar"
                        Width="100"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="btnCancelar_Click"/>

                <Button x:Name="btnGuardar"
                        Content="Guardar"
                        Width="100"
                        Height="35"
                        Click="btnGuardar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>